#!/command/with-contenv bash
# shellcheck shell=bash
# One-shot that warns once MariaDB is up if root still has the default password.
set -uo pipefail

for _ in $(seq 60); do
  mariadb-admin ping >/dev/null 2>&1 && break
  sleep 1
done

# Reads the accounts themselves, so it also notices a password changed with SQL.
# Socket login as OS root uses unix_socket; if that was removed, skip the check.
default_pw_roots=$(mariadb -N -e "SELECT COUNT(*) FROM mysql.user
  WHERE User = 'root' AND Host NOT IN ('localhost', '127.0.0.1', '::1')
  AND authentication_string = PASSWORD('root')" 2>/dev/null) || exit 0

if [ "$default_pw_roots" != "0" ]; then
  cat <<'BANNER'
[lamp] ************************************************************************
[lamp] WARNING: MariaDB root password is the default "root", and root can log in
[lamp] from outside the container. This is a development image. Do not expose
[lamp] port 3306 to untrusted networks. Set MARIADB_ROOT_PASSWORD on first start
[lamp] to choose another password, or change it later with SQL.
[lamp] ************************************************************************
BANNER
fi
echo "[lamp] default-password check done"
